\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{default}[2026/07/17 Minimal Default Journal Styles]
\RequirePackage{fancyhdr}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage[bf,hypcap]{caption}
\captionsetup{labelfont=bf,labelsep=period,aboveskip=4pt,belowskip=3pt}
\captionsetup[table]{position=above,aboveskip=4pt,belowskip=4pt}
\captionsetup[figure]{position=below,aboveskip=4pt,belowskip=2pt}

