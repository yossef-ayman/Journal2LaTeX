% !TeX spellcheck = en_US
\begin{abstract}
\noindent
In this work, we examine the robustness of the ill-posed Boussinesq equation by integration. This method is used to obtain solutions including trigonometric solutions, periodic solutions, exponential solutions, elliptic solutions and other solutions. It helps to better understand the meaning of the body(wave) and its equilibrium behavior, thus revealing the importance of studying various nonlinear waves occurring in physics and ocean engineering. These results are new and have not been repeated in previous works of other authors. For the purpose of visual presentation and physical explanation, we have drawn demonstration pictures of some solutions in 3D and 2D planes used in Mathematica software or Maple software. Therefore, we see that the solution results of the ill posed Boussinesq equation are different from the bell-like, weak solutions, periodic solutions and more types of solutions.
\end{abstract}
\textbf{Key words}:Unified approach method, Analytical soliton solutions, Ill-posed Boussinesq equation, Kink shaped soliton, Singular soliton and Periodic soliton solutions.
\section{Introduction}
\noindent The study of exact solutions of differential equations is one of the most useful topics in the literature and is also important for the presentation of many unclear topics in applied science and engineering. Nonlinear partial equations are used to model many parameters in fluid systems, signal processing, nonlinear systems, plasma physics, fluid dynamics, electricity, science and engineering. Soliton theory and isolation conditions are also relevant to this study and in this context, finding exact solutions of partial differential equations is an important study. Recent work in the last few years includes well-known techniques for obtaining optimal solutions to non-physical problems using computational models with the help of software such as Maple.These methods are as follows Homotopy perturbation method \cite{IFE3},Variational iteration method \cite{A2},the $G/G^{'}$ - Expansion method \cite{A3,a4,a5}, The Exp-Function method\cite{a6,a7,a8,a9}, Modified simple equation method \cite{a10,a11}, the tanh function method\cite{a12,a13,a14}, Kudryashov method \cite{a15,a16}, Trial equation method \cite{a17}, the Backscatter method\cite{a18}, Backlund transform\cite{a19}, Hirota bilinear method\cite{a20}, Homogeneous balance method\cite{a21}, Jacobi and Weierstrass elliptic function method\cite{a22}etc
This method (Unified approach) is one of the best method to find the exact solutions of the non linear partial differential equations [NLPDE]. In this paper we will apply this method demonstrate the behaviour and find the exact solution of the ill-posed Boussinesq equation. This method will provide many exact solutions of the ill-posed Boussinesq equation.
\section{The Unified Approach Method }
The methodology of unified approach method has the folllowing steps:
\subsection{Different Steps of the Unified Approach method}
\textbf{Step 1:}
We use the transformation equation to convert
\begin{eqnarray}
\Omega(u_x,u_t,u_{xt},u_{xx},u_{xxx}........)=0
\end{eqnarray}
into ODE form (By combining the variables we get).
\begin{eqnarray}\label{b1}
\Pi(U',U'',U''',.............)=0
\end{eqnarray}\\\
\textbf{Step 2:}
 Now we consider the solution of the equation eq${(2.2)}$ is of the form:
\begin{eqnarray}
\frac{d}{d \zeta}\eta \! \left(\zeta \right) =H_{0}+ \sum_{j=1}^N H_{j}.\eta \left(\zeta \right)^{j}+\sum_{j=1}^N \frac{F_{j}}{\eta \left(\zeta \right)^{j}}
\end{eqnarray}
\textbf{Step 3:}
Now by balancing the highest order non-linear term with the highest order derivative term in eq.(2.2) we will find the value of N.\\\
The Recatti Equation of the form:
\begin{eqnarray}
\frac{d}{d \zeta}\eta \! \left(\zeta \right) =\eta \! \left(\zeta \right)^{2}+M
\end{eqnarray}
Here we have different families ${\eta(\zeta)}$ of eq.$(2.4)$ depending upon the value of M.\\\
\textbf{when $\textbf{ M $<$ 0} $ }
\begin{align}
\begin{cases}\\\
\textbf{(i):}\quad \eta \! \left(\zeta \right) =\frac{-\sqrt{-\left(P^{2}+Q^{2}\right) M}-P \sqrt{-M}\, \cosh \! \left(2 \sqrt{-M}\, \left(\zeta +\phi \right)\right)}{P \sinh \! \left(2 \sqrt{-M}\, \left(\zeta +\phi \right)\right)+Q}\\\
\textbf{(ii):}\quad \eta \! \left(\zeta \right) =\frac{\sqrt{-\left(P^{2}+Q^{2}\right) M}-P \sqrt{-M}\, \cosh \! \left(2 \sqrt{-M}\, \left(\zeta +\phi \right)\right)}{P \sinh \! \left(2 \sqrt{-M}\, \left(\zeta +\phi \right)\right)+Q}\\\
\textbf{(iii):}\quad \eta \! \left(\zeta \right) =-\sqrt{-M}+\frac{2 P \sqrt{-M}}{P +\cosh \! \left(2 \sqrt{-M}\, \left(\zeta +\phi \right)\right)-\sinh \! \left(2 \sqrt{-M}\, \left(X +\phi \right)\right)}\\\
\textbf{(iv):}\quad \eta \! \left(\zeta \right) =\sqrt{-M}+\frac{2 P \sqrt{-M}}{P +\cosh \! \left(2 \sqrt{-M}\, \left(\zeta +\phi \right)\right)-\sinh \! \left(2 \sqrt{-M}\, \left(X +\phi \right)\right)}\\\
\end{cases}
\end{align}
\textbf{when $\textbf{ M $>$ 0} $ }
\begin{align}
\begin{cases}\\\
\textbf{(v):}\quad \eta \! \left(\zeta \right) =\frac{-\sqrt{\left(P^{2}+Q^{2}\right) M}-P \sqrt{M}\, \cos \! \left(2 \sqrt{M}\, \left(\zeta +\phi \right)\right)}{P \sin \! \left(2 \sqrt{M}\, \left(\zeta +\phi \right)\right)+Q}\\\
\textbf{(vi):}\quad \eta \! \left(\zeta \right) =\frac{\sqrt{\left(P^{2}+Q^{2}\right) M}-P \sqrt{M}\, \cos \! \left(2 \sqrt{M}\, \left(\zeta +\phi \right)\right)}{P \sin \! \left(2 \sqrt{M}\, \left(\zeta +\phi \right)\right)+Q}\\\
\textbf{(vii):}\quad \eta \! \left(\zeta \right) =-i \sqrt{M}+\frac{2 i P \sqrt{M}}{P +\cos \! \left(2 \sqrt{M}\, \left(\zeta +\phi \right)\right)-i \sin \! \left(2 \sqrt{M}\, \left(\zeta +\phi \right)\right)}\\\
\textbf{(viii):}\quad \eta \! \left(\zeta \right) =i \sqrt{-M}+\frac{2 i P \sqrt{M}}{P +\cosh \! \left(2 \sqrt{M}\, \left(\zeta +\phi \right)\right)-i \sin \! \left(2 \sqrt{M}\, \left(X +\phi \right)\right)}\\\
\end{cases}
\end{align}
\textbf{when $\textbf{ $M = 0$} $ }
\begin{eqnarray}
\textbf{(ix):}\quad \eta \! \left(\zeta \right) = -\frac{1}{\zeta +\phi}
\end{eqnarray}
\section{Solution of ill-posed Boussinesq Equation }
Consider Non-Linear ill-posed Boussinesq equation of the form:
\begin{eqnarray}
u_{\mathit{tt}} =u_{\mathit{xx}}+\left(u^{2}\right)_{\mathit{xx}}+u_{\mathit{xxxx}}
\end{eqnarray}
Using the transformation
\begin{eqnarray}
u(x,t)=U(\zeta) \qquad \zeta=x - v t 
\end{eqnarray}
in eq. (3.1) and integrating the result twice we get our required ODE form of ill-posed Boussinesq equation.
\begin{eqnarray}
\left(v^{2}-1\right) U -U^{2}-U_{\zeta \zeta} = 0
\end{eqnarray}
Now by using the Homogeneous Balancing Principle ( By balancing the highest order derivative term $U_{\zeta \zeta}$ with the highest degree non-linear term $U^{2}$, we get $N=2.$\\\\
Now by replacing $N=2$ in equation in eq.(2.3) we get
\begin{eqnarray}
U \! \left(\zeta \right) =H_{0}+H_{1} \eta \! \left(\zeta \right)+H_{2} \eta \! \left(\zeta \right)^{2}+\frac{F_{1}}{\eta \! \left(\zeta \right)}+\frac{F_{2}}{\eta \! \left(\zeta \right)^{2}}
\end{eqnarray}
Here we need to find the constants involved in $U{(\zeta)}$ which are $H_{0}$ , $H_{1}$ , $H_{2}$ , $F_{1}$ , $F_{2}$
The $\eta{(\zeta)}$ represents (the families given) the solutions of eq.(2.4).
Now substitute eq.(3.3) and eq.(2.4)in eq.(2.2) , then simplify resulting equation to get the co-efficients of all powers of ${\eta(\zeta)}$, and set all the co-efficients of different powers of $\eta{(\zeta)}$ equal to zero which will provide us a set of algebraic equations which can be solved simultaneously.
The co-efficients of different powers of $\eta{(\zeta)}$ are:\\\\\\
\begin{align}
\begin{cases}
\eta{(\zeta)}^{4} :\qquad-H_{2}^{2}-6 H_{2} = 0\\\
\eta{(\zeta)}^{3} :\qquad-2 H_{1} H_{2}-2 H_{1} = 0\\\
\eta{(\zeta)}^{2} :\qquad v^{2} H_{2}-8 M H_{2}-2 H_{0} H_{2}-H_{1}^{2}-H_{2} = 0\\\
\eta{(\zeta)}^{1} :\qquad H_{1} v^{2}-2 H_{1} M -2 H_{2} F_{1}-2 H_{0} H_{1}-H_{1} = 0\\\
\eta{(\zeta)}^{0} :\qquad -2 H_{2} M^{2}+H_{0} v^{2}-2 H_{1} F_{1}-2 H_{2} F_{2}-H_{0}^{2}-2 F_{2}-H_{0} = 0\\\
\eta{(\zeta)}^{1} :\qquad v^{2} F_{1}-2 M F_{1}-2 F_{1} H_{0}-2 F_{2} H_{1}-F_{1} = 0\\\
\eta{(\zeta)}^{2} :\qquad F_{2} v^{2}-8 F_{2} M -F_{1}^{2}-2 H_{0} F_{2}-F_{2} = 0\\\
\eta{(\zeta)}^{3} :\qquad -2 F_{1} M^{2}-2 F_{1} F_{2} = 0\\\
\eta{(\zeta)}^{4} :\qquad -2 F_{1} M^{2}-2 F_{1} F_{2} = 0\\\
\end{cases}
\end{align}
Now by using Maple software we find the simultaneous solution of these equations\\\
\textbf{Set I:}
\begin{eqnarray}
v = \sqrt{16 M -1},\,F_{1} = 0,\,F_{2} = -6 M^{2},\, H_{0} = -12 M,\, H_{1} = 0,\, H_{2} = -6
\end{eqnarray}
\textbf{Solution of Set I:}\\
By substituting eq. (3.2),(3.6) and using the following families \textbf{(v,vii,iv,ix)} in eq.(3.4) we will get the following solutions
\begin{eqnarray}
U_{1} \left(\zeta \right) =H_{0}+\frac{H_{2} \left(\sqrt{\left(P^{2}+Q^{2}\right) M}-P \sqrt{M}\, \cos \! \left(2 \sqrt{M}\, \left(-v t +\phi +x \right)\right)\right)}{P \sin \! \left(2 \sqrt{M}\, \left(-v t +\phi +x \right)\right)+Q}+\nonumber
\end{eqnarray}
\begin{eqnarray}
\frac{F_{2} \left(P \sin \! \left(2 \sqrt{M}\, \left(-v t +\phi +x \right)\right)+Q \right)^{2}}{{\left(\sqrt{\left(P^{2}+Q^{2}\right) M}-P \sqrt{M}\, \cos \! \left(2 \sqrt{M}\, \left(-v t +\phi +x \right)\right)\right)}^{2}}
\end{eqnarray}
\begin{eqnarray}
U_{2} \left(\zeta \right) =
H_{0}+\frac{H_{2} \left(-\sqrt{\left(P^{2}+Q^{2}\right) M}-P \sqrt{M}\, \cos \! \left(2 \sqrt{M}\, \left(-v t +\phi +x \right)\right)\right)}{P \sin \! \left(2 \sqrt{M}\, \left(-v t +\phi +x \right)\right)+Q}+\nonumber
\end{eqnarray}
\begin{eqnarray}
\frac{F_{2} \left(P \sin \! \left(2 \sqrt{M}\, \left(-v t +\phi +x \right)\right)+Q \right)^{2}}{{\left(-\sqrt{\left(P^{2}+Q^{2}\right) M}-P \sqrt{M}\, \cos \! \left(2 \sqrt{M}\, \left(-v t +\phi +x \right)\right)\right)}^{2}}
\end{eqnarray}
\begin{eqnarray}
U_{3} \left(\zeta \right) =
H_{0}+H_{2} \left(\sqrt{-M}+\frac{2 P \sqrt{-M}}{P +\cosh \! \left(2 \sqrt{-M}\, \left(-v t +\phi +x \right)\right)-\sinh \! \left(2 \sqrt{-M}\, \left(-v t +\phi +x \right)\right)}\right)+\nonumber
\end{eqnarray}
\begin{eqnarray}
\frac{F_{2}}{\left(\sqrt{-M}+\frac{2 P \sqrt{-M}}{P +\cosh \left(2 \sqrt{-M}\, \left(-v t +\phi +x \right)\right)-\sinh \left(2 \sqrt{-M}\, \left(-v t +\phi +x \right)\right)}\right)^{2}}
\end{eqnarray}
\begin{eqnarray}
U_{4}\left(\zeta \right) =H_{0}-\frac{H_{2}}{-v t +\phi +x}+F_{2} \left(-v t +\phi +x \right)^{2}
\end{eqnarray}
\textbf{Set II:}
\begin{eqnarray}
v = \sqrt{-4 M -1},\,F_{1} = 0,\,F_{2} = -6 M^{2},\, H_{0} = -2 M,\, H_{1} = 0,\, H_{2} = 0
\end{eqnarray}
By substituting eq. (3.11),(3.2) and using the following equations \textbf{(2.5),(2.7)} in eq. (3.4) we will get the following solutions.\\\
\textbf{Solution of Set II:}\\\
\begin{eqnarray}
U_{1}\! \left(\zeta \right) =H_{0}+\frac{F_{2} \left(P \sinh \! \left(2 \sqrt{-M}\, \left(-v t +\phi +x \right)\right)+Q \right)}{\sqrt{-\left(P^{2}+Q^{2}\right) M}-P \sqrt{-M}\, \cosh \! \left(2 \sqrt{-M}\, \left(-v t +\phi +x \right)\right)}
\end{eqnarray}
\begin{eqnarray}
U_{2}\! \left(\zeta \right) =H_{0}+\frac{F_{2} \left(P \sinh \! \left(2 \sqrt{-M}\, \left(-v t +\phi +x \right)\right)+Q \right)}{-\sqrt{-\left(P^{2}+Q^{2}\right) M}-P \sqrt{-M}\, \cosh \! \left(2 \sqrt{-M}\, \left(-v t +\phi +x \right)\right)}
\end{eqnarray}
\begin{eqnarray}
U_{3}\! \left(\zeta \right) =H_{0}+\frac{F_{2}}{\sqrt{-M}+\frac{2 P \sqrt{-M}}{P +\cosh \left(2 \sqrt{-M}\, \left(-v t +\phi +x \right)\right)-\sinh \left(2 \sqrt{-M}\, \left(-v t +\phi +x \right)\right)}}
\end{eqnarray}
\begin{eqnarray}
U_{4}\! \left(\zeta \right) =H_{0}+\frac{F_{2}}{-\sqrt{-M}+\frac{2 P \sqrt{-M}}{P +\cosh \left(2 \sqrt{-M}\, \left(-v t +\phi +x \right)\right)-\sinh \left(2 \sqrt{-M}\, \left(-v t +\phi +x \right)\right)}}
\end{eqnarray}
\begin{eqnarray}
U_{5}\! \left(\zeta \right) = H_{0}+F_{2} \left(v t -\phi -x \right)
\end{eqnarray}
\textbf{Set III:}
\begin{eqnarray}
M = M,\,v = \sqrt{-16 M -1},\,F_{1} = 0,\,F_{2} = -6 M^{2},\, H_{0} = 4 M,\, H_{1} = 0,\, H_{2} = -6
\end{eqnarray}
\textbf{Solution of Set III:}\\\
By substituting eq. (3.15),(2.1) and using the following equations \textbf{(2.6),(2.7),(2.8),(2.9),(2.14)} in eq. (3.3) we will get the following solutions\\\
\begin{eqnarray}
         U_{1}\ \left(\zeta \right) = H_{0}+H_{2} \left(\sqrt{-M}+\frac{2 P \sqrt{-M}}{P +\cosh \! \left(2 \sqrt{-M}\,
         \left(-t v +\phi +x \right)\right)-\sinh \! \left(2 \sqrt{-M}\, \left(-t v +\phi +x \right)\right)}\right)^{2}+\nonumber
\end{eqnarray}
\begin{eqnarray}
         \frac{F_{2}}{\left(\sqrt{-M}+\frac{2 P \sqrt{-M}}{P +\cosh \left(2 \sqrt{-M}\, \left(-t v +\phi +x \right)\right)-\sinh \left(2 \sqrt{-M}\,
         \left(-t v +\phi +x \right)\right)}\right)^{2}}
\end{eqnarray}
\begin{eqnarray}
U_{2}\! \left(\zeta \right) =
H_{0}+H_{2} \left(-\sqrt{-M}+\frac{2 P \sqrt{-M}}{P +\cosh \! \left(2 \sqrt{-M}\, \left(-t v +\phi +x \right)\right)-\sinh \! \left(2 \sqrt{-M}\, \left(-t v +\phi +x \right)\right)}\right)^{2}+\nonumber
\end{eqnarray}
\begin{eqnarray}
\frac{F_{2}}{\left(-\sqrt{-M}+\frac{2 P \sqrt{-M}}{P +\cosh \left(2 \sqrt{-M}\, \left(-t v +\phi +x \right)\right)-\sinh \left(2 \sqrt{-M}\, \left(-t v +\phi +x \right)\right)}\right)^{2}}
\end{eqnarray}
\begin{eqnarray}
U_{3}\! \left(\zeta \right) =
H_{0}+\frac{H_{2} {\left(\sqrt{-\left(P^{2}+Q^{2}\right) M}-P \sqrt{-M}\, \cosh \! \left(2 \sqrt{-M}\, \left(-t v +\phi +x \right)\right)\right)}^{2}}{\left(P \sinh \! \left(2 \sqrt{-M}\, \left(-t v +\phi +x \right)\right)+Q \right)^{2}}+\nonumber
\end{eqnarray}
\begin{eqnarray}
\frac{F_{2} \left(P \sinh \! \left(2 \sqrt{-M}\, \left(-t v +\phi +x \right)\right)+Q \right)^{2}}{{\left(\sqrt{-\left(P^{2}+Q^{2}\right) M}-P \sqrt{-M}\, \cosh \! \left(2 \sqrt{-M}\, \left(-t v +\phi +x \right)\right)\right)}^{2}}
\end{eqnarray}
\begin{eqnarray}
U_{4}\! \left(\zeta \right) =
H_{0}+\frac{H_{2} {\left(-\sqrt{-\left(P^{2}+Q^{2}\right) M}-P \sqrt{-M}\, \cosh \! \left(2 \sqrt{-M}\, \left(-t v +\phi +x \right)\right)\right)}^{2}}{\left(P \sinh \! \left(2 \sqrt{-M}\, \left(-t v +\phi +x \right)\right)+Q \right)^{2}}+\nonumber
\end{eqnarray}
\begin{eqnarray}
\frac{F_{2} \left(P \sinh \! \left(2 \sqrt{-M}\, \left(-t v +\phi +x \right)\right)+Q \right)^{2}}{{\left(-\sqrt{-\left(P^{2}+Q^{2}\right) M}-P \sqrt{-M}\, \cosh \! \left(2 \sqrt{-M}\, \left(-t v +\phi +x \right)\right)\right)}^{2}}
\end{eqnarray}
\begin{eqnarray}
U_{5}\! \left(\zeta \right) =
H_{0}+\frac{H_{2}}{\left(-t v +\phi +x \right)^{2}}+F_{2} \left(-t v +\phi +x \right)^{2}
\end{eqnarray}
