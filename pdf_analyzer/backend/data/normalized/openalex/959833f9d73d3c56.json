      "year": 2021,
      "publication_date": "2021-09-01",
      "journal": "Acta Physica Polonica A",
      "venue": "Acta Physica Polonica A",
      "publisher": "Polish Academy of Sciences",
      "reference_type": "journal-article",
      "volume": "140",
      "issue": "3",
      "pages": "265-272",
      "doi": "10.12693/aphyspola.140.265",
