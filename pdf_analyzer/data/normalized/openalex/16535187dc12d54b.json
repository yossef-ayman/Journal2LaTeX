      "journal": "Acervo Digital da Universidade Estadual Paulista (Universidade Estadual Paulista)",
      "venue": "Acervo Digital da Universidade Estadual Paulista (Universidade Estadual Paulista)",
      "publisher": "Fundação para o Desenvolvimento da UNESP",
      "reference_type": "journal-article",
