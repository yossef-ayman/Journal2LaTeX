      "pages": "1780-1789",
      "doi": "10.1002/1521-4141(200106)31:6<1780::aid-immu1780>3.0.co;2-i",
      "url": "https://doi.org/10.1002/1521-4141(200106)31:6<1780::aid-immu1780>3.0.co;2-i",
      "pdf_url": "https://onlinelibrary.wiley.com/doi/pdfdirect/10.1002/1521-4141%28200106%2931%3A6%3C1780%3A%3AAID-IMMU1780%3E3.0.CO%3B2-I",
