# Backend API base URL used by the frontend (axios client + health checks).
#
# Development (default, see .env):
#   VITE_API_URL=https://gleaming-clarity-production-2550.up.railway.app
#
# Production on Vercel (see .env.production, or set in the Vercel dashboard):
#   VITE_API_URL=https://gleaming-clarity-production-2550.up.railway.app
#
# Vite env precedence (later overrides earlier):
#   shell env > .env.production.local > .env.production > .env.development.local
#   > .env.development > .env.local > .env
# If the variable is missing everywhere, src/config.ts falls back to the local
# development backend at http://localhost:8000.
VITE_API_URL=
